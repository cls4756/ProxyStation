# Copy this file to `.env` for local use.
# Do not commit your real `.env` file.

# Web admin credentials
PROXYSTATION_WEB_USERNAME=admin
PROXYSTATION_WEB_PASSWORD=change-this-password

# Container timezone
TZ=Asia/Shanghai

# Optional published host ports when not using host networking
PROXYSTATION_WEB_PORT=2026
PROXYSTATION_SOCKS_PORT=20260
PROXYSTATION_HTTP_PORT=20261
PROXYSTATION_SOCKS_UDP_PORT=20262

# Host path for persistent runtime data
PROXYSTATION_DATA_DIR=./data
